<Window x:Class="AtenaBattery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atena Battery"
        Width="156" Height="176"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Canvas x:Name="RootCanvas" Width="156" Height="176" Background="Transparent">
        <!-- Dark Glass Disc -->
        <Ellipse Width="106" Height="106" Canvas.Left="25" Canvas.Top="11"
                 Fill="#F20F131C" Stroke="#262F44" StrokeThickness="1.5"/>
        <Ellipse Width="98" Height="98" Canvas.Left="29" Canvas.Top="15"
                 Fill="Transparent" Stroke="#181E2C" StrokeThickness="1"/>

        <!-- Recessed Track Ring -->
        <Ellipse Width="82" Height="82" Canvas.Left="37" Canvas.Top="23"
                 Fill="Transparent" Stroke="#1E2534" StrokeThickness="7"/>

        <!-- Neon Glow Arc -->
        <Path x:Name="GlowArc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45">
            <Path.Effect>
                <BlurEffect Radius="8"/>
            </Path.Effect>
        </Path>

        <!-- Main Progress Arc -->
        <Path x:Name="ProgressArc" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- Center Typography -->
        <StackPanel Canvas.Left="25" Canvas.Top="41" Width="106" HorizontalAlignment="Center">
            <TextBlock x:Name="PercentText" Text="--%" Foreground="White"
                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="SCANNING" Foreground="#7D8CA3"
                       FontFamily="Segoe UI" FontSize="8" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
        </StackPanel>

        <!-- Bottom Pill Badge -->
        <Border Canvas.Left="13" Canvas.Top="126" Width="130" Height="28"
                CornerRadius="14" Background="#F20F131C" BorderBrush="#262F44" BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PrevBtn" Grid.Column="0" Text="◀" Foreground="#8B9BB4"
                           FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="PrevBtn_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#606D80" Margin="0,0,5,0"/>
                    <TextBlock x:Name="DeviceNameText" Text="Scanning..." Foreground="#F0F4F8"
                               FontFamily="Segoe UI" FontSize="10.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="82"/>
                </StackPanel>

                <TextBlock x:Name="NextBtn" Grid.Column="2" Text="▶" Foreground="#8B9BB4"
                           FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="NextBtn_Click"/>
            </Grid>
        </Border>
    </Canvas>
</Window>
